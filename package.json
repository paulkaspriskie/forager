{
  "name": "forager",
  "version": "0.1.0",
  "description": "",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "deploy:api": "wrangler deploy --config deploy/cloudflare/wrangler.toml",
    "build": "npm run build -w forager-web-app",
    "start": "concurrently -k -n API,WEB \"cargo run --manifest-path ./Cargo.toml\" \"npm run dev --prefix apps/web\"",
    "watch": "npm run build:watch -w forager-web-app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulkaspriskie/forager.git"
  },
  "author": "Paul Kaspriskie",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/paulkaspriskie/forager/issues"
  },
  "homepage": "https://github.com/paulkaspriskie/forager#readme",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "wrangler": "^4.169.0"
  }
}
