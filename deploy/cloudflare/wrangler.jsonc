{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forager-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "containers": [
    {
      "class_name": "ForagerApi",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../../apps/api/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FORAGER_API", "class_name": "ForagerApi" }]
  },
  "exports": {
    "ForagerApi": { "type": "durable-object", "storage": "sqlite" }
  }
}